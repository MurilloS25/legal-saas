# Supabase public browser-safe values.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is the current recommended name by Supabase SSR docs.
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the legacy name — still accepted for backward compatibility.
# Set whichever your Supabase project provides. The application reads PUBLISHABLE_KEY first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret.
# Never expose this value through NEXT_PUBLIC_* variables.
# Never import or use it in Client Components, browser bundles, or shared client utilities.
SUPABASE_SERVICE_ROLE_KEY=

# AI-assisted Machote generation ("Crear con IA"). Server-only: never use
# NEXT_PUBLIC_* for these. Leave AI_PROVIDER empty to disable the feature.
# AI_PROVIDER=openai uses OPENAI_*; AI_PROVIDER=anthropic uses ANTHROPIC_*.
# The model has no default: set the provider's *_MODEL explicitly.
# AI_PROVIDER=fake enables a deterministic simulated provider for local/E2E
# only; it is refused in production builds.
# Also requires SUPABASE_SERVICE_ROLE_KEY (quota ledger).
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional, only for organization API keys not scoped to a workspace
# (Anthropic then requires the anthropic-workspace-id header). Not a secret.
ANTHROPIC_WORKSPACE_ID=
# Optional overrides. Defaults: 10000000 bytes, 5 pages, 2 generations per
# user per day, 120000 ms per provider call. File size and pages can only be
# lowered; the daily limit accepts 0-1000; the timeout 5000-240000.
AI_TEMPLATE_MAX_FILE_BYTES=
AI_TEMPLATE_MAX_PAGES=
AI_TEMPLATE_DAILY_LIMIT=
AI_TEMPLATE_TIMEOUT_MS=

# E2E test credentials (Playwright authenticated tests).
# Create a dedicated test user in Supabase local and set these values in .env.local.
# Never commit real credentials. These are placeholders only.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
